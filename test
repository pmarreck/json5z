#!/usr/bin/env bash
# Complete json5z test entry point: unit, conformance and differential tests,
# the mutation control, a bounded fuzz campaign against the reference json5
# library, and the Nix flake check. Accumulates failures; non-zero if any fail.
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root" || exit 1
failures=0

run() {
	printf '==> %s\n' "$*"
	"$@"
	local rc=$?
	if [ "$rc" -ne 0 ]; then
		printf 'FAILED (%s): %s\n' "$rc" "$*" >&2
		failures=$((failures + 1))
	fi
}

run nix develop -c zig build test --summary all
run nix develop -c zig build
run nix develop -c tests/cli/cli.bash
run nix develop -c ./mutate
run nix develop -c ./fuzz 1 20000
run nix develop -c node tests/fuzz/spec_reference.mjs tests/ledgers/spec_reference_json5.txt tests/spec_cases/json5_1.0.cases tests/spec_cases/mined.cases tests/spec_cases/rulings.cases
run nix flake check

exit "$failures"
