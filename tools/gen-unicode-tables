#!/usr/bin/env bash
# Regenerate src/unicode_tables.zig from the Unicode Character Database in
# nixpkgs. JSON5 identifiers and whitespace follow ECMAScript 5.1, which
# defines them by Unicode general category.
#
# Usage: tools/gen-unicode-tables [path/to/DerivedGeneralCategory.txt]
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src="${1:-}"
if [ -z "$src" ]; then
	ucd="$(nix build --no-link --print-out-paths nixpkgs#unicode-character-database)" || exit 1
	src="$ucd/share/unicode/extracted/DerivedGeneralCategory.txt"
fi
out="$root/src/unicode_tables.zig"
luajit - "$src" "$out" <<-'LUA'
	local src, out = arg[1], arg[2]
	local sets = {
		id_start = { Lu = true, Ll = true, Lt = true, Lm = true, Lo = true, Nl = true },
		id_continue_only = { Mn = true, Mc = true, Nd = true, Pc = true },
		space_separator = { Zs = true },
	}
	local ranges = { id_start = {}, id_continue_only = {}, space_separator = {} }
	local version
	for line in io.lines(src) do
		version = version or line:match("^# DerivedGeneralCategory%-(%d+%.%d+%.%d+)%.txt")
		local lo, hi, cat = line:match("^(%x+)%.%.(%x+)%s*;%s*(%a%a)")
		if not lo then
			lo, cat = line:match("^(%x+)%s*;%s*(%a%a)")
			hi = lo
		end
		if lo then
			for name, cats in pairs(sets) do
				if cats[cat] then table.insert(ranges[name], { tonumber(lo, 16), tonumber(hi, 16) }) end
			end
		end
	end
	assert(version, "Unicode version header not found in " .. src)
	local f = assert(io.open(out, "w"))
	f:write("//! Generated by tools/gen-unicode-tables from Unicode ", version, "\n")
	f:write("//! DerivedGeneralCategory.txt. Do not edit by hand.\n\n")
	f:write("pub const unicode_version = \"", version, "\";\n")
	for _, name in ipairs({ "id_start", "id_continue_only", "space_separator" }) do
		local r = ranges[name]
		table.sort(r, function(a, b) return a[1] < b[1] end)
		local merged = {}
		for _, x in ipairs(r) do
			local last = merged[#merged]
			if last and x[1] <= last[2] + 1 then
				if x[2] > last[2] then last[2] = x[2] end
			else
				merged[#merged + 1] = { x[1], x[2] }
			end
		end
		f:write("\n/// Sorted, non-overlapping, non-adjacent inclusive code point ranges.\n")
		f:write("pub const ", name, " = [_][2]u21{\n")
		for _, x in ipairs(merged) do f:write(string.format("    .{ 0x%04X, 0x%04X },\n", x[1], x[2])) end
		f:write("};\n")
	end
	f:close()
LUA
