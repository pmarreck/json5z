# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	PLAN.md = Ordered open work for the cj5 fork
	cj5.h = cj5 C parser: the degraded oracle, with a validate-only O(depth) mode
	docs/plan_context/json5z.md = json5z decision, goals and oracle order (conformance suite, cj5 degraded oracle, fuzz/mutation)
	interim/cj5_modified = Interim library: cj5 with our grammar fixes and validate-only mode; deleted once the Zig validator replaces it
	interim/cj5_modified/cj5.h = Modified cj5 C parser (interim library code, not an oracle), with a validate-only O(depth) mode
	interim/cj5_modified/tests/oracle = Frozen pre-refactor copy of the modified cj5; refactoring regression check only, not a JSON5 oracle
	mutate = Mutation control: deliberate cj5.h bugs under timeout; each must fail the tests
	src/json5z.zig = json5z core: streaming JSON5 1.0 validator, UTF-8 decoding across chunks, one bit per open container
	src/unicode_tables.zig = Generated Unicode 17.0.0 ranges for identifier start/part and Zs whitespace
	test = Complete test entry point: zig tests, ./mutate, nix flake check
	tests/conformance.zig = Conformance control: every suite case against each implementation, with exact disagreement ledgers
	tests/differential.zig = Three-way differential: frozen reference vs live token vs validate-only parser, seeded fuzz
	tests/json5_tests = Official JSON5 conformance suite (json5/json5-tests ceb24d4, MIT), pinned by MANIFEST.sha256
	tests/ledgers = Exact sets of conformance cases each implementation gets wrong
	tests/oracle/cj5_reference.h = Frozen cj5.h at 3a32d25 renamed cj5ref_*, test-only oracle
	tests/upstream_cj5 = Degraded oracle: unmodified septag/cj5 5fe4821 (sha256-pinned) and a verdict-only judge wrapper
	tools/gen-unicode-tables = Regenerates src/unicode_tables.zig from the nixpkgs Unicode Character Database
]
