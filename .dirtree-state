# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	PLAN.md = Ordered open work for the cj5 fork
	bm = Timing campaign: json5z vs upstream cj5 through the performance-profile engine (profiling.json)
	cj5.h = cj5 C parser: the degraded oracle, with a validate-only O(depth) mode
	cli/json5z.c = C CLI: streams files/stdin through the C ABI; text, JSON Lines and quiet output
	docs/plan_context/benchmark_cj5.md = Benchmark method, declared shapes and 2026-10-28 results: json5z vs upstream cj5
	docs/plan_context/json5z.md = json5z decision, goals and oracle order (conformance suite, cj5 degraded oracle, fuzz/mutation)
	docs/plan_context/settings_and_notes.md = Design for ambiguity settings (file, env, flags) and the notes that report which settings shaped a result
	docs/plan_context/spec_rulings.md = The six ambiguity rulings and their reasons
	fuzz = Bounded differential fuzz campaign: json5z (wasm) vs reference json5 library
	include/json5z.h = C ABI header: status codes, opaque streaming validator, pointer+length input
	interim/cj5_modified = Interim library: cj5 with our grammar fixes and validate-only mode; deleted once the Zig validator replaces it
	interim/cj5_modified/cj5.h = Modified cj5 C parser (interim library code, not an oracle), with a validate-only O(depth) mode
	interim/cj5_modified/tests/oracle = Frozen pre-refactor copy of the modified cj5; refactoring regression check only, not a JSON5 oracle
	mg = Memory growth and cleanup cases (mode mg) through ./bm
	mutate = Mutation control: deliberate cj5.h bugs under timeout; each must fail the tests
	profiling.json = performance-profile cases: json5z, cj5-presized, cj5-two-pass on six workload kinds; timing at 1 and 12 cores, tracked peak memory
	src/ffi.zig = C ABI exports over the json5z core
	src/json5z.zig = json5z core: streaming JSON5 1.0 validator, UTF-8 decoding across chunks, one bit per open container
	src/unicode_tables.zig = Generated Unicode 17.0.0 ranges for identifier start/part and Zs whitespace
	test = Complete test entry point: zig tests, ./mutate, nix flake check
	tests/benchmark/bench.c = json5z-bench: seeded JSON5 workload generator plus timed, verdict-checked runs of json5z and upstream cj5 (performance-measurement/v1)
	tests/benchmark/cj5_shim.c = Unmodified upstream cj5 behind two static-linked functions for the benchmark
	tests/benchmark/cj5_shim.h = Declarations for the benchmark's upstream cj5 shim
	tests/benchmark/contract.bash = Untimed benchmark checks in ./test: optimized build, workloads valid per reference json5, verdict checks bite, protocol shape
	tests/benchmark/json5z_shim.zig = C-callable json5z validate with a counting allocator for the benchmark's memory figures
	tests/benchmark/reference_check.mjs = Reference json5 must accept a benchmark workload and reject its corrupted copy
	tests/cli/cli.bash = CLI contract tests: exit codes, stdin forms, spaces in paths, output modes
	tests/conformance.zig = Conformance control: every suite case against each implementation, with exact disagreement ledgers
	tests/differential.zig = Three-way differential: frozen reference vs live token vs validate-only parser, seeded fuzz
	tests/ffi_test.zig = C ABI contract tests: NULL policy, embedded NUL, chunked feeding
	tests/fuzz/differential.mjs = Node driver: seeded grammar-shaped and mutated inputs, reference vs json5z, chunk-split invariance, shrinking
	tests/fuzz/json5z_wasm.zig = WebAssembly exports of the json5z core for the fuzzer
	tests/fuzz/number_range.mjs = Differential fuzz of number_range=binary64 against JavaScript Number()/BigInt near the 2^1024-2^970 overflow boundary
	tests/fuzz/spec_reference.mjs = Runs the case files against the reference json5 library with its ledger
	tests/harness.zig = Judges for each implementation and the exact-ledger set comparison
	tests/json5_tests = Official JSON5 conformance suite (json5/json5-tests ceb24d4, MIT), pinned by MANIFEST.sha256
	tests/ledgers = Exact sets of conformance cases each implementation gets wrong
	tests/oracle/cj5_reference.h = Frozen cj5.h at 3a32d25 renamed cj5ref_*, test-only oracle
	tests/spec_cases.zig = Runs both case files against json5z and upstream cj5 with exact ledgers
	tests/spec_cases/json5_1.0.cases = 687 grammar-derived JSON5 cases, each citing its production; written without reading json5z
	tests/spec_cases/mined.cases = 84 cases from other JSON5 parsers' bug reports, each with its source
	tests/spec_cases/rulings.cases = BDFN rulings on inputs the JSON5 spec leaves ambiguous, as corpus cases
	tests/upstream_cj5 = Degraded oracle: unmodified septag/cj5 5fe4821 (sha256-pinned) and a verdict-only judge wrapper
	tools/gen-unicode-tables = Regenerates src/unicode_tables.zig from the nixpkgs Unicode Character Database
]
