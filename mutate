#!/usr/bin/env bash
# Mutation control for the interim parser's validate-only mode and the
# degraded oracle's integrity check. Each mutant is a deliberate
# bug applied to a scratch copy of the tree; `zig build test` must FAIL on it.
# A mutant that passes (survived) or exceeds its time limit (hung) fails this
# script, so the differential tests are shown to bite and to terminate.
#
# Usage: ./mutate            (run inside `nix develop`; ./test does this)
# Env:   CJ5_MUTANT_TIMEOUT  seconds per mutant (default 300)
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
limit="${CJ5_MUTANT_TIMEOUT:-300}"
work="$(mktemp -d "${TMPDIR:-/tmp}/json5z-mutate.XXXXXX")"
failures=0

# replace FILE OLD NEW: exact, single-occurrence substitution (fails loudly).
replace() {
	luajit - "$@" <<-'LUA'
		local path, old, new = arg[1], arg[2], arg[3]
		local f = assert(io.open(path, "rb")); local s = f:read("*a"); f:close()
		local a, e = s:find(old, 1, true)
		assert(a and not s:find(old, e + 1, true), "mutation anchor missing or not unique in " .. path)
		f = assert(io.open(path, "wb")); f:write(s:sub(1, a - 1) .. new .. s:sub(e + 1)); f:close()
	LUA
}

mutant_chain_drops_parent() {
	# Truncation also drops super_id's own frame, and a lookup miss silently
	# returns the newest frame: wrong structure with no assertion.
	replace interim/cj5_modified/cj5.h 'parser->chain[keep - 1].id > parser->super_id' \
		'parser->chain[keep - 1].id >= parser->super_id' &&
	replace interim/cj5_modified/cj5.h $'    CJ5_ASSERT(0);\n    parser->chain_lost = true;\n    return &parser->chain_scratch;' \
		'    return &parser->chain[parser->chain_len - 1].token;'
}

mutant_open_count_sticks() {
	# Closing a container never decrements the open count.
	replace interim/cj5_modified/cj5.h $'                    --parser.open_count;\n' ''
}

mutant_oracle_edited() {
	# One appended byte in the vendored upstream cj5.h; the blessed hash must catch it.
	printf '\n' >>tests/upstream_cj5/cj5.h
}

mutant_ledger_forgets_case() {
	# Drop one ledgered upstream disagreement; the conformance set check must fail.
	replace tests/ledgers/upstream_cj5.txt $'misc/empty.txt\tsuite=reject\tgot=accept\n' ''
}

mutant_corpus_case_edited() {
	# Flip a must-reject case into valid JSON5; its manifest hash must catch it.
	printf '[]' >tests/json5_tests/misc/empty.txt
}

mutant_json5z_raw_lf_in_string() {
	# Accept an unescaped LF inside a string.
	replace src/json5z.zig "} else if (cp == '\n' or cp == '\r') {" "} else if (cp == '\r') {"
}

mutant_json5z_accepts_surrogates() {
	# Accept UTF-8-encoded surrogate code points.
	replace src/json5z.zig '(cp >= 0xD800 and cp <= 0xDFFF) or ' ''
}

mutant_json5z_literal_unchecked() {
	# Accept any characters in place of a literal's remaining letters.
	replace src/json5z.zig 'if (cp != self.word[self.word_index]) return self.fail();' ''
}

mutant_json5z_object_comma_skips_key() {
	# After a comma in an object, expect a value instead of a key.
	replace src/json5z.zig "',' => self.expect = .object_key_or_close," "',' => self.expect = .object_value,"
}

mutant_json5z_astral_identifiers() {
	# Accept letters beyond the Basic Multilingual Plane in unquoted keys
	# whatever astral_identifiers says.
	replace src/json5z.zig 'return self.options.astral_identifiers == .accept;' 'return true;'
}

mutant_json5z_unpaired_high_surrogate() {
	# Accept any escape after an escaped high surrogate in a key.
	replace src/json5z.zig $'                    if (named < 0xDC00 or named > 0xDFFF) return self.fail();\n' ''
}

mutant_json5z_line_separator_note_kept() {
	# Keep line-separator notes for a valid document, which prints no position.
	replace src/json5z.zig $'        if (verdict == .valid) self.notes.line_separators = .{};\n' ''
}

mutant_json5z_crlf_counts_twice() {
	# Count CR LF as two line breaks.
	replace src/json5z.zig $'        if (lf_after_cr) return;\n' ''
}

mutant_json5z_depth_off_by_one() {
	# Allow one level beyond max_depth.
	replace src/json5z.zig 'self.depth == self.options.max_depth' 'self.depth > self.options.max_depth'
}

mutant_json5z_escaped_letter_unchecked() {
	# Accept any escaped letter inside a literal under escaped_literals = accept.
	replace src/json5z.zig $'                        if (named != self.word[self.word_index]) return self.fail();\n' ''
}

mutant_json5z_overflow_ignores_digits() {
	# Judge binary64 overflow by order of magnitude alone, ignoring the digits.
	replace src/json5z.zig 'return order > limit or (order == limit and m.order == .at_least);' 'return order > limit;'
}

mutants=(mutant_chain_drops_parent mutant_open_count_sticks mutant_oracle_edited
	mutant_ledger_forgets_case mutant_corpus_case_edited
	mutant_json5z_raw_lf_in_string mutant_json5z_accepts_surrogates
	mutant_json5z_literal_unchecked mutant_json5z_object_comma_skips_key
	mutant_json5z_astral_identifiers mutant_json5z_crlf_counts_twice
	mutant_json5z_unpaired_high_surrogate mutant_json5z_line_separator_note_kept
	mutant_json5z_depth_off_by_one mutant_json5z_escaped_letter_unchecked
	mutant_json5z_overflow_ignores_digits)

for m in "${mutants[@]}"; do
	dir="$work/$m"
	mkdir -p "$dir"
	(cd "$root" && git ls-files -co --exclude-standard | grep -v '^inbox/') |
		while IFS= read -r p; do
			mkdir -p "$dir/$(dirname "$p")" && cp "$root/$p" "$dir/$p"
		done
	if ! (cd "$dir" && "$m"); then
		printf 'ERROR    %s: could not apply\n' "$m"
		failures=$((failures + 1))
		continue
	fi
	(cd "$dir" && timeout --kill-after=10 "$limit" zig build test >"$dir.log" 2>&1)
	rc=$?
	case "$rc" in
		0) printf 'SURVIVED %s (tests passed on a deliberate bug; log %s)\n' "$m" "$dir.log"; failures=$((failures + 1)) ;;
		124|137) printf 'HUNG     %s (exceeded %ss; log %s)\n' "$m" "$limit" "$dir.log"; failures=$((failures + 1)) ;;
		*) printf 'KILLED   %s\n' "$m" ;;
	esac
done

exit "$failures"
